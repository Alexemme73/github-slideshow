                    onMoveESound = { index, delta -> eSoundPlaylists = eSoundStore.move(eSoundPlaylists, index, delta) },
                    onOpenESoundPlaylist = { playlist ->
                        runCatching { context.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(playlist.url))) }
                            .onFailure { error = "Impossibile aprire la playlist eSound" }
                    },
                    onOpenESoundApp = {
                        val launch = context.packageManager.getLaunchIntentForPackage("com.esound")
                        runCatching {
                            if (launch != null) context.startActivity(launch)
                            else context.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse("https://esound.app/")))
                        }.onFailure { error = "Impossibile aprire eSound" }
                    }
                )
            }
        }
    }
}

@Composable
private fun HomeScreen(
    topTracks: List<Track>, newTracks: List<Track>, loading: Boolean,
    onPlay: (List<Track>, Int) -> Unit,
    onFavorite: (Track) -> Unit,
    isFavorite: (Track) -> Boolean,
    onGenre: (String) -> Unit,
    onYear: (Int) -> Unit
) {
    LazyColumn(contentPadding = PaddingValues(bottom = 16.dp)) {
        item {
            HeroHeader()
            SourceInfoCard()
            SectionTitle("Generi")
            GenreRow(onGenre)
            SectionTitle("Per anno")
            YearRow(onYear)
        }
        if (loading && topTracks.isEmpty()) item { LinearProgressIndicator(Modifier.fillMaxWidth()) }
        if (!loading && topTracks.isEmpty() && newTracks.isEmpty()) {
            item {
                Text(
                    "Il catalogo musicale non ha restituito brani. Le radio restano separate e non vengono usate come sostituti.",
                    modifier = Modifier.padding(16.dp),
                    color = MaterialTheme.colorScheme.onSurfaceVariant
                )
            }
        }
        item {
            SectionTitle("Più ascoltate · musica gratuita")
            TrackCarousel(topTracks, onPlay, onFavorite, isFavorite)
            SectionTitle("Novità · artisti indipendenti")
            TrackCarousel(newTracks, onPlay, onFavorite, isFavorite)
        }
    }
}

@Composable
private fun HeroHeader() {
    Box(
        Modifier.padding(16.dp).fillMaxWidth().height(150.dp).clip(RoundedCornerShape(24.dp))
            .background(Brush.linearGradient(listOf(Color(0xFF3A1020), Color(0xFF201531), Color(0xFF111114))))
    ) {
        Column(Modifier.align(Alignment.CenterStart).padding(20.dp)) {
            Text("Musica gratuita", fontSize = 26.sp, fontWeight = FontWeight.Black)
            Spacer(Modifier.height(6.dp))
            Text("Brani e artisti indipendenti. Le radio sono disponibili solo nella sezione Radio.", color = MaterialTheme.colorScheme.onSurfaceVariant)
        }
    }
}

@Composable
private fun SourceInfoCard() {
    Card(Modifier.padding(horizontal = 16.dp).fillMaxWidth()) {
        Column(Modifier.padding(14.dp)) {
            Text("Catalogo musicale", fontWeight = FontWeight.Bold)
            Spacer(Modifier.height(4.dp))
            Text("Musica: catalogo Jamendo. Nessuna radio viene mescolata ai risultati musicali o alle playlist.", fontSize = 12.sp, color = MaterialTheme.colorScheme.onSurfaceVariant)
        }
    }
}

@Composable
private fun GenreRow(onGenre: (String) -> Unit) {
    val genres = listOf("pop", "rock", "electronic", "hiphop", "jazz", "classical", "metal", "relaxation", "world", "soundtrack")
    LazyRow(contentPadding = PaddingValues(horizontal = 16.dp), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
        items(genres) { g -> AssistChip(onClick = { onGenre(g) }, label = { Text(g.replaceFirstChar { it.uppercase() }) }) }
    }
}

@Composable
private fun YearRow(onYear: (Int) -> Unit) {
    val current = remember { Year.now().value }
    val years = remember { (current downTo 2005).toList() }
    LazyRow(contentPadding = PaddingValues(horizontal = 16.dp), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
        items(years) { y -> FilterChip(selected = false, onClick = { onYear(y) }, label = { Text(y.toString()) }) }
    }
}

@Composable
private fun ExploreScreen(
    tracks: List<Track>, loading: Boolean,
    onPlay: (List<Track>, Int) -> Unit,
    onGenre: (String) -> Unit,
    onFavorite: (Track) -> Unit,
    isFavorite: (Track) -> Boolean
) {
    LazyColumn(contentPadding = PaddingValues(bottom = 16.dp)) {
        item { SectionTitle("Esplora musica gratuita"); GenreRow(onGenre) }
        if (loading) item { LinearProgressIndicator(Modifier.fillMaxWidth()) }
        if (!loading && tracks.isEmpty()) item {
            Text(
                "Nessun brano trovato. Prova un'altra ricerca o un altro genere.",
                modifier = Modifier.padding(16.dp),
                color = MaterialTheme.colorScheme.onSurfaceVariant
            )
        }
        items(tracks) { track ->
            val index = tracks.indexOf(track)
            TrackRow(track, onClick = { onPlay(tracks, index) }, onFavorite = { onFavorite(track) }, favorite = isFavorite(track))
        }
    }
}

@Composable
private fun RadioScreen(
    stations: List<RadioStation>,
    loading: Boolean,
    error: String?,
    filter: String,
    query: String,
    lastRefresh: Long,
    onFilterChange: (String) -> Unit,
    onQueryChange: (String) -> Unit,
    onRefresh: () -> Unit,
    onPlay: (RadioStation) -> Unit
) {
    val filters = listOf("Tutte", "Pop", "Rock", "News", "Talk", "Dance", "Jazz", "Classica")
    val filtered = remember(stations, filter, query) {
        stations.filter { station ->
            val text = (station.name + " " + station.tags + " " + station.state).lowercase()
            val qOk = query.isBlank() || text.contains(query.trim().lowercase())
            val fOk = when (filter) {
                "Tutte" -> true
                "Classica" -> text.contains("classical") || text.contains("classica")
                else -> text.contains(filter.lowercase())
            }
            qOk && fOk
        }
    }

    LazyColumn(contentPadding = PaddingValues(bottom = 16.dp)) {
        item {
            Row(Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp), verticalAlignment = Alignment.CenterVertically) {
                Column(Modifier.weight(1f)) {
                    Text("Radio Italia", fontSize = 28.sp, fontWeight = FontWeight.Black)
