        },
        bottomBar = {
            Column {
                AnimatedVisibility(visible = playerUi.title.isNotBlank()) {
                    MiniPlayer(
                        state = playerUi,
                        onPlayPause = { if (controller?.isPlaying == true) controller.pause() else controller?.play() },
                        onPrevious = { controller?.seekToPreviousMediaItem() },
                        onNext = { controller?.seekToNextMediaItem() }
                    )
                }
                NavigationBar(containerColor = Color(0xFF111114)) {
                    NavigationBarItem(selected = tab == Tab.Home, onClick = { tab = Tab.Home }, icon = { Icon(Icons.Default.Home, null) }, label = { Text("Musica") })
                    NavigationBarItem(selected = tab == Tab.Explore, onClick = { tab = Tab.Explore }, icon = { Icon(Icons.Default.Explore, null) }, label = { Text("Esplora") })
                    NavigationBarItem(selected = tab == Tab.Playlists, onClick = { tab = Tab.Playlists; searchOpen = false }, icon = { Icon(Icons.Default.PlaylistPlay, null) }, label = { Text("Playlist") })
                    NavigationBarItem(selected = tab == Tab.Radio, onClick = { tab = Tab.Radio; searchOpen = false }, icon = { Icon(Icons.Default.Radio, null) }, label = { Text("Radio") })
                }
            }
        }
    ) { padding ->
        Column(Modifier.padding(padding).fillMaxSize()) {
            AnimatedVisibility(searchOpen && (tab == Tab.Home || tab == Tab.Explore)) {
                SearchBarBlock(
                    query = query,
                    onQueryChange = { query = it },
                    onSearch = {
                        if (query.isNotBlank()) scope.launch {
                            loading = true
                            try {
                                searchResults = jamendo.search(query)
                                tab = Tab.Explore
                            } catch (t: Throwable) {
                                error = t.message ?: "Ricerca non disponibile"
                            } finally {
                                loading = false
                            }
                        }
                    }
                )
            }
            error?.let { AssistChip(onClick = { error = null }, label = { Text(it, maxLines = 1, overflow = TextOverflow.Ellipsis) }) }

            when (tab) {
                Tab.Home -> HomeScreen(
                    topTracks = topTracks,
                    newTracks = newTracks,
                    loading = loading,
                    onPlay = { list, index -> playQueue(controller, list, index) },
                    onFavorite = { track -> favorites = toggleFavorite(favorites, track) },
                    isFavorite = { track -> favorites.any { it.id == track.id } },
                    onGenre = { genre ->
                        scope.launch {
                            loading = true
                            try { searchResults = jamendo.byGenre(genre); tab = Tab.Explore }
                            catch (t: Throwable) { error = t.message }
                            finally { loading = false }
                        }
                    },
                    onYear = { year ->
                        scope.launch {
                            loading = true
                            try { searchResults = jamendo.byYear(year); tab = Tab.Explore }
                            catch (t: Throwable) { error = t.message }
                            finally { loading = false }
                        }
                    }
                )

                Tab.Explore -> ExploreScreen(
                    tracks = if (searchResults.isNotEmpty()) searchResults else topTracks,
                    loading = loading,
                    onPlay = { list, index -> playQueue(controller, list, index) },
                    onGenre = { genre ->
                        scope.launch {
                            loading = true
                            try { searchResults = jamendo.byGenre(genre) }
                            catch (t: Throwable) { error = t.message }
                            finally { loading = false }
                        }
                    },
                    onFavorite = { track -> favorites = toggleFavorite(favorites, track) },
                    isFavorite = { track -> favorites.any { it.id == track.id } }
                )

                Tab.Radio -> RadioScreen(
                    stations = radios,
                    loading = radioLoading,
                    error = radioError,
                    filter = radioFilter,
                    query = radioQuery,
                    lastRefresh = lastRadioRefresh,
                    onFilterChange = { radioFilter = it },
                    onQueryChange = { radioQuery = it },
                    onRefresh = {
                        scope.launch {
                            radioLoading = true
                            try {
                                radios = radioRepository.italianStations()
                                radioError = null
                                lastRadioRefresh = System.currentTimeMillis()
                            } catch (t: Throwable) {
                                radioError = t.message ?: "Radio non disponibili"
                            } finally {
                                radioLoading = false
                            }
                        }
                    },
                    onPlay = { station ->
                        playRadio(controller, station)
                        scope.launch { radioRepository.registerClick(station.id) }
                    }
                )

                Tab.Playlists -> PlaylistScreen(
                    favorites = favorites,
                    eSoundPlaylists = eSoundPlaylists,
                    onPlay = { list, index -> playQueue(controller, list, index) },
                    onAddESound = { name, url ->
                        runCatching { eSoundStore.add(eSoundPlaylists, name, url) }
                            .onSuccess { eSoundPlaylists = it }
                            .onFailure { error = it.message ?: "Link eSound non valido" }
                    },
                    onRemoveESound = { id -> eSoundPlaylists = eSoundStore.remove(eSoundPlaylists, id) },
