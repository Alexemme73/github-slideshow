                    NavigationBarItem(selected = tab == Tab.Explore, onClick = { tab = Tab.Explore }, icon = { Icon(Icons.Default.Explore, null) }, label = { Text("Esplora") })
                    NavigationBarItem(selected = tab == Tab.Radio, onClick = { tab = Tab.Radio; searchOpen = false }, icon = { Icon(Icons.Default.Radio, null) }, label = { Text("Radio") })
                    NavigationBarItem(selected = tab == Tab.Library, onClick = { tab = Tab.Library }, icon = { Icon(Icons.Default.LibraryMusic, null) }, label = { Text("Libreria") })
                }
            }
        }
    ) { padding ->
        Column(Modifier.padding(padding).fillMaxSize()) {
            AnimatedVisibility(searchOpen && tab != Tab.Radio) {
                SearchBarBlock(
                    query = query,
                    onQueryChange = { query = it },
                    onSearch = {
                        if (query.isNotBlank()) scope.launch {
                            loading = true
                            try {
                                searchResults = jamendo.search(query)
                                tab = Tab.Explore
                            } catch (t: Throwable) {
                                error = t.message ?: "Ricerca non disponibile"
                            } finally {
                                loading = false
                            }
                        }
                    }
                )
            }
            error?.let { AssistChip(onClick = { error = null }, label = { Text(it, maxLines = 1, overflow = TextOverflow.Ellipsis) }) }

            when (tab) {
                Tab.Home -> HomeScreen(
                    topTracks = topTracks,
                    newTracks = newTracks,
                    loading = loading,
                    onPlay = { list, index -> playQueue(controller, list, index) },
                    onFavorite = { track -> favorites = toggleFavorite(favorites, track) },
                    isFavorite = { track -> favorites.any { it.id == track.id } },
                    onGenre = { genre ->
                        scope.launch {
                            loading = true
                            try { searchResults = jamendo.byGenre(genre); tab = Tab.Explore }
                            catch (t: Throwable) { error = t.message }
                            finally { loading = false }
                        }
                    },
                    onYear = { year ->
                        scope.launch {
                            loading = true
                            try { searchResults = jamendo.byYear(year); tab = Tab.Explore }
                            catch (t: Throwable) { error = t.message }
                            finally { loading = false }
                        }
                    },
                    onOpenRadio = { tab = Tab.Radio }
                )

                Tab.Explore -> ExploreScreen(
                    tracks = if (searchResults.isNotEmpty()) searchResults else topTracks,
                    loading = loading,
                    onPlay = { list, index -> playQueue(controller, list, index) },
                    onGenre = { genre ->
                        scope.launch {
                            loading = true
                            try { searchResults = jamendo.byGenre(genre) }
                            catch (t: Throwable) { error = t.message }
                            finally { loading = false }
                        }
                    },
                    onFavorite = { track -> favorites = toggleFavorite(favorites, track) },
                    isFavorite = { track -> favorites.any { it.id == track.id } }
                )

                Tab.Radio -> RadioScreen(
                    stations = radios,
                    loading = radioLoading,
                    error = radioError,
                    filter = radioFilter,
                    query = radioQuery,
                    lastRefresh = lastRadioRefresh,
                    onFilterChange = { radioFilter = it },
                    onQueryChange = { radioQuery = it },
                    onRefresh = {
                        scope.launch {
                            radioLoading = true
                            try {
                                radios = radioRepository.italianStations()
                                radioError = null
                                lastRadioRefresh = System.currentTimeMillis()
                            } catch (t: Throwable) {
                                radioError = t.message ?: "Radio non disponibili"
                            } finally {
                                radioLoading = false
                            }
                        }
                    },
                    onPlay = { station ->
                        playRadio(controller, station)
                        scope.launch { radioRepository.registerClick(station.id) }
                    }
                )

                Tab.Library -> LibraryScreen(
                    favorites = favorites,
                    onPlay = { list, index -> playQueue(controller, list, index) }
                )
            }
        }
    }
}

@Composable
private fun HomeScreen(
    topTracks: List<Track>, newTracks: List<Track>, loading: Boolean,
    onPlay: (List<Track>, Int) -> Unit,
    onFavorite: (Track) -> Unit,
    isFavorite: (Track) -> Boolean,
    onGenre: (String) -> Unit,
    onYear: (Int) -> Unit,
    onOpenRadio: () -> Unit
) {
    LazyColumn(contentPadding = PaddingValues(bottom = 16.dp)) {
        item {
            HeroHeader(onOpenRadio)
            SourceInfoCard()
            SectionTitle("Generi")
            GenreRow(onGenre)
            SectionTitle("Per anno")
            YearRow(onYear)
        }
        if (loading && topTracks.isEmpty()) item { LinearProgressIndicator(Modifier.fillMaxWidth()) }
        item {
            SectionTitle("Più ascoltate · musica gratuita")
            TrackCarousel(topTracks, onPlay, onFavorite, isFavorite)
            SectionTitle("Novità · artisti indipendenti")
            TrackCarousel(newTracks, onPlay, onFavorite, isFavorite)
        }
    }
}

@Composable
private fun HeroHeader(onOpenRadio: () -> Unit) {
    Box(
        Modifier.padding(16.dp).fillMaxWidth().height(170.dp).clip(RoundedCornerShape(24.dp))
            .background(Brush.linearGradient(listOf(Color(0xFF3A1020), Color(0xFF201531), Color(0xFF111114))))
    ) {
        Column(Modifier.align(Alignment.CenterStart).padding(20.dp)) {
            Text("Musica libera + radio italiane", fontSize = 24.sp, fontWeight = FontWeight.Black)
            Spacer(Modifier.height(6.dp))
            Text("Streaming musicale gratuito e radio online in un unico player.", color = MaterialTheme.colorScheme.onSurfaceVariant)
            Spacer(Modifier.height(12.dp))
            FilledTonalButton(onClick = onOpenRadio) {
