                    Text(
                        if (lastRefresh > 0L) "Lista aggiornata alle ${DateFormat.getTimeInstance(DateFormat.SHORT).format(Date(lastRefresh))}"
                        else "Aggiornamento lista in corso…",
                        color = MaterialTheme.colorScheme.onSurfaceVariant,
                        fontSize = 12.sp
                    )
                }
                FilledTonalIconButton(onClick = onRefresh, enabled = !loading) {
                    Icon(Icons.Default.Refresh, "Aggiorna")
                }
            }

            OutlinedTextField(
                value = query,
                onValueChange = onQueryChange,
                modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp),
                singleLine = true,
                placeholder = { Text("Cerca radio, città o genere…") },
                leadingIcon = { Icon(Icons.Default.Search, null) }
            )

            LazyRow(contentPadding = PaddingValues(horizontal = 16.dp, vertical = 10.dp), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                items(filters) { f ->
                    FilterChip(selected = filter == f, onClick = { onFilterChange(f) }, label = { Text(f) })
                }
            }

            Text(
                "Le stazioni sono recuperate online e la lista si aggiorna automaticamente ogni 30 minuti. I flussi segnalati come non funzionanti vengono esclusi.",
                modifier = Modifier.padding(horizontal = 16.dp, vertical = 4.dp),
                fontSize = 12.sp,
                color = MaterialTheme.colorScheme.onSurfaceVariant
            )
        }

        if (loading && stations.isEmpty()) item { LinearProgressIndicator(Modifier.fillMaxWidth()) }
        error?.let { message -> item { Text(message, Modifier.padding(16.dp), color = MaterialTheme.colorScheme.error) } }
        if (!loading && filtered.isEmpty()) item { Text("Nessuna radio trovata con questi filtri.", Modifier.padding(16.dp), color = MaterialTheme.colorScheme.onSurfaceVariant) }

        items(filtered, key = { it.id }) { station ->
            RadioRow(station = station, onClick = { onPlay(station) })
        }
    }
}

@Composable
private fun RadioRow(station: RadioStation, onClick: () -> Unit) {
    Row(
        Modifier.fillMaxWidth().clickable(onClick = onClick).padding(horizontal = 16.dp, vertical = 8.dp),
        verticalAlignment = Alignment.CenterVertically
    ) {
        if (station.imageUrl.isNotBlank()) {
            AsyncImage(
                model = station.imageUrl,
                contentDescription = null,
                modifier = Modifier.size(58.dp).clip(RoundedCornerShape(10.dp)),
                contentScale = ContentScale.Crop
            )
        } else {
            Surface(Modifier.size(58.dp), shape = RoundedCornerShape(10.dp), color = MaterialTheme.colorScheme.surfaceVariant) {
                Box(contentAlignment = Alignment.Center) { Icon(Icons.Default.Radio, null) }
            }
        }
        Spacer(Modifier.width(12.dp))
        Column(Modifier.weight(1f)) {
            Text(station.name, maxLines = 1, overflow = TextOverflow.Ellipsis, fontWeight = FontWeight.SemiBold)
            val details = buildList {
                if (station.state.isNotBlank()) add(station.state)
                if (station.codec.isNotBlank()) add(station.codec)
                if (station.bitrate > 0) add("${station.bitrate} kbps")
            }.joinToString(" · ")
            Text(details.ifBlank { "Radio online italiana" }, color = MaterialTheme.colorScheme.onSurfaceVariant, maxLines = 1, fontSize = 12.sp)
            if (station.tags.isNotBlank()) {
                Text(station.tags, color = MaterialTheme.colorScheme.onSurfaceVariant, maxLines = 1, overflow = TextOverflow.Ellipsis, fontSize = 11.sp)
            }
        }
        Icon(Icons.Default.PlayArrow, "Riproduci")
    }
}

@Composable
private fun PlaylistScreen(
    favorites: List<Track>,
    eSoundPlaylists: List<ESoundPlaylist>,
    onPlay: (List<Track>, Int) -> Unit,
    onAddESound: (String, String) -> Unit,
    onRemoveESound: (String) -> Unit,
    onMoveESound: (Int, Int) -> Unit,
    onOpenESoundPlaylist: (ESoundPlaylist) -> Unit,
    onOpenESoundApp: () -> Unit
) {
    var name by remember { mutableStateOf("") }
    var url by remember { mutableStateOf("") }

    LazyColumn(
        contentPadding = PaddingValues(horizontal = 16.dp, vertical = 12.dp),
        verticalArrangement = Arrangement.spacedBy(10.dp)
    ) {
        item {
            Text("Playlist", fontSize = 28.sp, fontWeight = FontWeight.Black)
            Spacer(Modifier.height(6.dp))
            Text(
                "Libreria eSound: aggiungi qui i link pubblici delle tue playlist. TubeMusic non richiede né memorizza la password eSound.",
                color = MaterialTheme.colorScheme.onSurfaceVariant,
                fontSize = 13.sp
            )
            Spacer(Modifier.height(10.dp))
            FilledTonalButton(onClick = onOpenESoundApp) {
                Icon(Icons.Default.OpenInNew, null)
                Spacer(Modifier.width(8.dp))
                Text("Apri eSound")
            }
            Spacer(Modifier.height(12.dp))
            OutlinedTextField(
                value = name,
                onValueChange = { name = it },
                modifier = Modifier.fillMaxWidth(),
                singleLine = true,
                label = { Text("Nome playlist") },
                placeholder = { Text("es. Preferite, Palestra, Anni 90") }
            )
            OutlinedTextField(
                value = url,
                onValueChange = { url = it },
                modifier = Modifier.fillMaxWidth(),
                singleLine = true,
                label = { Text("Link pubblico playlist eSound") },
                placeholder = { Text("Incolla il link condiviso da eSound") }
            )
            Spacer(Modifier.height(8.dp))
            Button(
                onClick = {
                    if (url.isNotBlank()) {
                        onAddESound(name, url)
                        name = ""
                        url = ""
                    }
                },
                enabled = url.isNotBlank()
            ) {
                Icon(Icons.Default.PlaylistAdd, null)
                Spacer(Modifier.width(8.dp))
                Text("Aggiungi alla libreria")
            }
            SectionTitle("Libreria eSound", horizontalPadding = 0.dp)
