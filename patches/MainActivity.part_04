            IconButton(onClick = onPlayPause) { Icon(if (state.isPlaying) Icons.Default.Pause else Icons.Default.PlayArrow, null, modifier = Modifier.size(30.dp)) }
            IconButton(onClick = onNext) { Icon(Icons.Default.SkipNext, null) }
        }
    }
}

private fun playQueue(controller: MediaController?, tracks: List<Track>, index: Int) {
    if (controller == null || tracks.isEmpty()) return
    controller.setMediaItems(tracks.map(Track::toMediaItem), index.coerceIn(tracks.indices), 0L)
    controller.prepare()
    controller.play()
}

private fun playRadio(controller: MediaController?, station: RadioStation) {
    if (controller == null) return
    controller.setMediaItem(station.toMediaItem())
    controller.prepare()
    controller.play()
}

private fun toggleFavorite(favorites: List<Track>, track: Track): List<Track> =
    if (favorites.any { it.id == track.id }) favorites.filterNot { it.id == track.id } else favorites + track
