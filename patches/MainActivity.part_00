class MainActivity : ComponentActivity() {
    private var controllerFuture: ListenableFuture<MediaController>? = null
    private var controllerState = mutableStateOf<MediaController?>(null)

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        requestNotificationPermissionIfNeeded()
        setContent {
            TubeMusicTheme {
                TubeMusicApp(controller = controllerState.value)
            }
        }
    }

    override fun onStart() {
        super.onStart()
        val token = SessionToken(this, ComponentName(this, PlaybackService::class.java))
        controllerFuture = MediaController.Builder(this, token).buildAsync().also { future ->
            future.addListener({
                try { controllerState.value = future.get() } catch (_: Exception) { controllerState.value = null }
            }, ContextCompat.getMainExecutor(this))
        }
    }

    override fun onStop() {
        controllerFuture?.let(MediaController::releaseFuture)
        controllerFuture = null
        controllerState.value = null
        super.onStop()
    }

    private fun requestNotificationPermissionIfNeeded() {
        if (Build.VERSION.SDK_INT >= 33 && checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) {
            requestPermissions(arrayOf(Manifest.permission.POST_NOTIFICATIONS), 12)
        }
    }
}

private enum class Tab { Home, Explore, Playlists, Radio }

@OptIn(ExperimentalMaterial3Api::class)
@Composable
private fun TubeMusicApp(controller: MediaController?) {
    val context = LocalContext.current
    val jamendo = remember { JamendoRepository() }
    val radioRepository = remember { RadioBrowserRepository() }
    val eSoundStore = remember { ESoundPlaylistStore(context.applicationContext) }
    val scope = rememberCoroutineScope()

    var tab by remember { mutableStateOf(Tab.Home) }
    var topTracks by remember { mutableStateOf<List<Track>>(emptyList()) }
    var newTracks by remember { mutableStateOf<List<Track>>(emptyList()) }
    var loading by remember { mutableStateOf(true) }
    var error by remember { mutableStateOf<String?>(null) }
    var searchOpen by remember { mutableStateOf(false) }
    var query by remember { mutableStateOf("") }
    var searchResults by remember { mutableStateOf<List<Track>>(emptyList()) }
    var favorites by remember { mutableStateOf<List<Track>>(emptyList()) }
    var eSoundPlaylists by remember { mutableStateOf(eSoundStore.load()) }

    var radios by remember { mutableStateOf<List<RadioStation>>(emptyList()) }
    var radioLoading by remember { mutableStateOf(true) }
    var radioError by remember { mutableStateOf<String?>(null) }
    var radioFilter by remember { mutableStateOf("Tutte") }
    var radioQuery by remember { mutableStateOf("") }
    var lastRadioRefresh by remember { mutableLongStateOf(0L) }

    LaunchedEffect(Unit) {
        try {
            topTracks = jamendo.top()
            newTracks = jamendo.newReleases()
        } catch (t: Throwable) {
            error = t.message ?: "Errore di rete"
        } finally {
            loading = false
        }
    }

    LaunchedEffect(Unit) {
        while (true) {
            radioLoading = true
            try {
                radios = radioRepository.italianStations()
                radioError = null
                lastRadioRefresh = System.currentTimeMillis()
            } catch (t: Throwable) {
                radioError = t.message ?: "Radio non disponibili"
            } finally {
                radioLoading = false
            }
            delay(30 * 60 * 1000L)
        }
    }

    val playerUi = rememberPlayerUiState(controller)

    Scaffold(
        containerColor = MaterialTheme.colorScheme.background,
        topBar = {
            CenterAlignedTopAppBar(
                title = { Text("TubeMusic", fontWeight = FontWeight.Black, letterSpacing = 0.3.sp) },
                actions = {
                    if (tab == Tab.Home || tab == Tab.Explore) {
                        IconButton(onClick = { searchOpen = !searchOpen }) { Icon(Icons.Default.Search, "Cerca") }
                    }
                },
                colors = TopAppBarDefaults.topAppBarColors(containerColor = MaterialTheme.colorScheme.background)
            )
